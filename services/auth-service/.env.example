DATABASE_URL="your_database_url"
JWT_SECRET="jwt_secret"
JWT_REFRESH_SECRET="jwt_refresh_token_secret"
JWT_EXPIRES_IN="jwt_expires_in"          # e.g. 15m
JWT_REFRESH_EXPIRES_IN="jwt_refresh_token_expires_in"  # e.g. 7d
BCRYPT_ROUNDS="bcrypt_rounds"           # e.g. 10
PORT="port_to_run_your_application_on"                    # e.g. 3001
NODE_ENV="development_or_prod_testing"
