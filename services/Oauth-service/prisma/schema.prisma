generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model OAuthUser {
  id String @id  @default(uuid())
  email String @unique
  name String?
  avatarUrl String?
  provider providerEnum
  providerUserId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  oauthTokens OAuthToken[]
  refreshTokens OAuthRefreshToken[]
  @@unique([provider , providerUserId])

}

// stores provider access token, used to call provider apis on behalf of the user.
model OAuthToken {
  id String @id @default(uuid())
  userId String  // fk -> OAuthUser
  provider providerEnum
  accessToken String
  refreshToken String
  createdAt DateTime @default(now())
  expiresAt DateTime?
  user OAuthUser @relation(fields: [userId] , references: [id])
  @@unique([userId, provider])

}

model OAuthRefreshToken {
  id String @id @default(uuid())
  userId String // fk -> oauthuser
  token String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user OAuthUser @relation(fields: [userId] , references: [id])
  
}

enum providerEnum {
  google
  github
}
